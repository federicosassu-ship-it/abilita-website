---
/** Domande frequenti con <details>/<summary> nativi: accessibili da tastiera e senza JavaScript. */
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details class="faq__item">
      <summary class="faq__q">
        <span>{item.q}</span>
        <Icon name="plus" class="faq__icon" />
      </summary>
      <div class="faq__a"><p>{item.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--c-line); }
  .faq__item { border-bottom: 1px solid var(--c-line); }
  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-5);
    min-height: 3.5rem;
    padding-block: var(--sp-4);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.25;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--c-blue-strong); }
  .faq__q :global(.faq__icon) { width: 1.5rem; height: 1.5rem; transition: transform var(--dur-2) var(--ease-out); }
  .faq__item[open] .faq__q :global(.faq__icon) { transform: rotate(45deg); }
  .faq__a { padding-bottom: var(--sp-5); max-width: 60ch; color: var(--c-ink-2); }
</style>
