---
/**
 * Hero delle pagine interne: percorso, occhiello, H1, testo, azioni e composizione grafica.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import PixelField from './PixelField.astro';
import type { Crumb } from '../layouts/Base.astro';

interface Props {
  label: string;
  title: string;
  lead: string;
  breadcrumbs?: Crumb[];
  pattern?: 'about' | 'ecommerce' | 'food' | 'ads' | 'network' | 'careers' | 'contact';
  seed?: number;
}
const { label, title, lead, breadcrumbs, pattern, seed } = Astro.props;
---
<section class="page-hero" aria-labelledby="titolo-pagina">
  <div class="container">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <div class:list={['page-hero__grid', { 'page-hero__grid--visual': pattern }]}>
      <div class="page-hero__text">
        <p class="eyebrow">{label}</p>
        <h1 id="titolo-pagina" set:html={title} />
        <p class="lead page-hero__lead">{lead}</p>
        <slot name="actions" />
      </div>
      {pattern && (
        <div class="page-hero__visual">
          <PixelField variant={pattern} animate seed={seed} />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero { padding-block: var(--sp-5) var(--section-y); }
  .page-hero__grid { display: grid; gap: var(--sp-7); margin-top: clamp(1.5rem, 1rem + 3vw, 4rem); }
  .page-hero__text { display: grid; gap: var(--sp-5); justify-items: start; }
  .page-hero__text h1 { max-width: 16ch; font-size: clamp(2.35rem, 1.55rem + 4vw, 5rem); }
  .page-hero__lead { max-width: 50ch; }
  .page-hero__visual { width: min(100%, 13rem); justify-self: start; }
  @media (min-width: 64rem) {
    .page-hero__grid--visual { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: end; }
    .page-hero__grid--visual .page-hero__text { grid-column: 1 / span 8; }
    .page-hero__grid--visual .page-hero__visual { grid-column: 10 / span 3; width: 100%; justify-self: end; }
  }
</style>
