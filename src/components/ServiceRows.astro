---
/**
 * Elenco editoriale dei servizi: una riga per servizio con valore, destinatari, attività e link.
 * Il link è sul nome del servizio (nome accessibile breve); l'area cliccabile si estende
 * all'intera riga con uno pseudo-elemento.
 */
import Icon from './Icon.astro';
import PixelField from './PixelField.astro';
import { services } from '../data/services';
interface Props { headingLevel?: 'h2' | 'h3'; position?: string }
const { headingLevel = 'h3', position = 'home' } = Astro.props;
const H = headingLevel;
---
<ol class="service-rows" role="list">
  {services.map((s, i) => (
    <li class="service-row" data-reveal style={`--reveal-delay:${i * 90}ms`}>
      <span class="service-row__num tabular" aria-hidden="true">{s.number}</span>
      <div class="service-row__main">
        <H class="service-row__name">
          <a
            class="service-row__link"
            href={`/servizi/${s.slug}/`}
            data-track="servizio_click"
            data-track-props={JSON.stringify({ servizio: s.slug, posizione: position })}
          >{s.name}</a>
        </H>
        <p class="service-row__tagline">{s.home.tagline}</p>
      </div>
      <div class="service-row__detail">
        <p class="service-row__for">{s.home.forWho}</p>
        <ul class="service-row__tags" role="list" aria-label={`Attività: ${s.name}`}>
          {s.capabilities.map((c) => <li class="service-row__tag">{c.title}</li>)}
        </ul>
        <span class="service-row__more" aria-hidden="true">Scopri il servizio <Icon name="arrow-right" /></span>
      </div>
      <div class="service-row__visual" aria-hidden="true">
        <PixelField variant={s.pattern} />
      </div>
    </li>
  ))}
</ol>

<style>
  .service-rows { list-style: none; padding: 0; border-top: 1px solid var(--c-ink); }
  .service-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--sp-4);
    padding-block: var(--sp-6);
    border-bottom: 1px solid var(--c-line);
  }
  .service-row__num { font-size: var(--step--1); font-weight: 600; color: var(--c-muted); padding-top: 0.6rem; }
  .service-row__main { display: grid; gap: var(--sp-2); align-content: start; }
  .service-row__name {
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .service-row__link {
    color: var(--c-ink);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out);
  }
  .service-row__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .service-row__link:focus-visible { outline: none; }
  .service-row:has(.service-row__link:focus-visible) { outline: 2px solid var(--c-focus); outline-offset: 4px; }
  .service-row__tagline { font-size: var(--step-1); color: var(--c-ink-2); max-width: 30ch; line-height: 1.4; }
  .service-row__detail { grid-column: 2; display: grid; gap: var(--sp-4); align-content: start; }
  .service-row__for { font-weight: 500; }
  .service-row__tags { display: flex; flex-wrap: wrap; gap: var(--sp-2); list-style: none; padding: 0; }
  .service-row__tag {
    font-size: var(--step--1);
    line-height: 1.3;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--c-line);
    background: var(--c-paper);
    color: var(--c-ink-2);
  }
  .service-row__more { display: inline-flex; align-items: center; gap: 0.5em; font-weight: 600; min-height: 2.75rem; }
  .service-row__more :global(.icon) { transition: transform var(--dur-2) var(--ease-out); }
  .service-row__visual { display: none; }

  .service-row:hover .service-row__link { color: var(--c-blue-strong); }
  .service-row:hover .service-row__more :global(.icon) { transform: translateX(4px); }

  @media (min-width: 64rem) {
    .service-row {
      grid-template-columns: 3rem minmax(0, 5fr) minmax(0, 5fr) minmax(0, 2fr);
      gap: var(--col-gap);
      padding-block: var(--sp-7);
      align-items: start;
    }
    .service-row__detail { grid-column: auto; }
    .service-row__visual {
      display: block;
      width: 100%;
      max-width: 9rem;
      justify-self: end;
      transition: transform var(--dur-3) var(--ease-out);
    }
    .service-row:hover .service-row__visual { transform: translateY(-4px); }
  }
</style>
