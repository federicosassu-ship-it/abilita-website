# Configurazione pubblica del sito (nessun segreto: questi valori finiscono nel codice del browser).
# Copia questo file in .env e modifica i valori, oppure impostali nel pannello dell'hosting.

# Destinazione del modulo di contatto. Predefinito: gestore PHP incluso (/api/contatto.php),
# adatto all'hosting Aruba attuale. Per altri hosting: URL di un servizio compatibile
# (risposta 2xx in JSON con "ok": true a una POST con Accept: application/json).
PUBLIC_FORM_ENDPOINT=/api/contatto.php

# iubenda Cookie Solution (ID del sito attuale). PUBLIC_IUBENDA_BANNER=false per non caricare il banner.
PUBLIC_IUBENDA_SITE_ID=3743319
PUBLIC_IUBENDA_COOKIE_POLICY_ID=55509982
PUBLIC_IUBENDA_BANNER=true

# Misurazione (facoltativa, disattivata se vuota). Esempio Plausible:
# PUBLIC_ANALYTICS_DOMAIN=abilita.biz
# PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=

# true per ambienti di anteprima: aggiunge noindex e blocca robots.txt
PUBLIC_NOINDEX=false
